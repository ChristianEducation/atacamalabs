    {
      "id": "5c3b7d6b-3dea-45c4-ba74-160af65de34d",
      "name": "Build Relations",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        4080,
        -120
      ],
      "parameters": {
        "jsCode": "const c = $('Context').first().json;\nconst servicioId = ($('Create Servicio').first().json.record || {}).id;\nif (!servicioId) throw new Error('No se creó el Servicio contratado');\nlet proyectoId = null;\nif (c.proyecto) { proyectoId = (($('Create Proyecto').first().json || {}).record || {}).id || null; }\nconst R = [{ label: 'servicio↔oportunidad', associationId: '6ac4412e79bbec5a0686f0ea', firstRecordId: servicioId, secondRecordId: c.opportunityId },\n  { label: 'business↔servicio', associationId: '6ac4412e1ef24423a65a24b6', firstRecordId: c.businessId, secondRecordId: servicioId }];\nif (!c.oppHasBusinessRel) R.push({ label: 'business↔oportunidad', associationId: '6aab99ca4b0508155da7f710', firstRecordId: c.businessId, secondRecordId: c.opportunityId });\nif (!c.contactHasBusiness) R.push({ label: 'business↔contacto', associationId: 'BUSINESSES_CONTACTS_ASSOCIATION', firstRecordId: c.businessId, secondRecordId: c.contactId });\nif (proyectoId) {\n  R.push({ label: 'business↔proyecto', associationId: '6ac4412fd143f08a0a642c44', firstRecordId: c.businessId, secondRecordId: proyectoId });\n  R.push({ label: 'proyecto↔servicio', associationId: '6ac44130ad83d04a973c2511', firstRecordId: proyectoId, secondRecordId: servicioId });\n}\nreturn R.map((r) => ({ json: { ...r, locationId: 'pxHuOsiz2i3lM6BtC9IM', servicioId, proyectoId } }));"
      }
    },
