      "id": "44617108-adfb-49f5-a845-48aa3849c0da",
      "name": "Validate Input",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        0
      ],
      "parameters": {
        "jsCode": "const first = $input.first().json ?? {};\nconst body = first.body ?? first;\n// El Webhook estandar de GHL manda los Custom Data dentro de body.customData; tambien se acepta la raiz.\nconst cd = body && typeof body.customData === 'object' && body.customData ? body.customData : {};\nconst present = (v) => v !== undefined && v !== null && v !== '';\nconst id = String(present(body.opportunity_id) ? body.opportunity_id : (cd.opportunity_id ?? '')).trim();\nif (!/^[A-Za-z0-9]{15,30}$/.test(id)) throw new Error('opportunity_id invalido');\n// SEGURIDAD: solo es dry_run=false si hay al menos un valor y TODOS los presentes (raiz y customData)\n// son false (booleano o \"false\"). Ausente, invalido, ambiguo o contradictorio => dry_run=true.\nconst isFalse = (v) => v === false || (typeof v === 'string' && v.trim().toLowerCase() === 'false');\nconst given = [body.dry_run, cd.dry_run].filter((v) => v !== undefined && v !== null);\nconst dryRun = !(given.length > 0 && given.every(isFalse));\nreturn [{ json: { opportunityId: id, dryRun } }];"
      }
    },
