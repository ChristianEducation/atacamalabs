    {
      "id": "build-ghl-payload",
      "name": "Build GHL Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        120
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Une lo reclamado del job con el contexto del diagnóstico. Si el lead no trae\n// contexto (Nayra, leads antiguos) o la consulta falla, se conserva el\n// comportamiento previo: solution del job tal cual.\nconst claim = $('Claim Sync Jobs').item.json;\nconst raw = $json && !Array.isArray($json) ? $json : {};\nconst ctx = raw.service || raw.diagnostic_data ? raw : {};\n\nconst SERVICE = { agentes: 'Agentes', 'a-medida': 'A Medida', web: 'Página Web', general: 'No definido' };\nconst PLAN = { esencial: 'Esencial', operacion: 'Operación', escala: 'Escala', landing: 'Landing', profesional: 'Web Profesional', ecommerce: 'Ecommerce' };\nconst INTEREST = { comercial: 'Comercial', cobranza: 'Cobranza', 'administracion-finanzas': 'Administración / Finanzas', atencion: 'Atención', agendamiento: 'Agendamiento', procesos: 'Procesos', unsure: 'Por definir' };\nconst DATA = { agent_goal: 'Objetivo del agente', delegation_note: 'Qué quiere delegar', process_description: 'Proceso a mejorar', web_goal: 'Objetivo de la web', web_note: 'Comentario', general_note: 'Comentario', legacy_industry: 'Rubro' };\n\nconst service = ctx.service || null;\nconst plan = ctx.plan || null;\n\nlet solution = claim.solution || 'unsure';\nif (service) {\n  solution = service === 'web' && plan === 'ecommerce' ? 'Ecommerce' : (SERVICE[service] || 'No definido');\n}\n\nconst lines = [];\nif (service) {\n  lines.push('Diagnóstico desde la web');\n  lines.push('Servicio: ' + (SERVICE[service] || service));\n  if (plan) lines.push('Plan: ' + (PLAN[plan] || plan));\n  if (ctx.interest) lines.push('Interés: ' + (INTEREST[ctx.interest] || ctx.interest));\n  const origin = [ctx.source_page, ctx.source_section, ctx.source_cta].filter(Boolean).join(' > ');\n  if (origin) lines.push('Origen: ' + origin);\n  if (ctx.campaign) lines.push('Campaña: ' + ctx.campaign);\n  const data = ctx.diagnostic_data && typeof ctx.diagnostic_data === 'object' ? ctx.diagnostic_data : {};\n  for (const [key, label] of Object.entries(DATA)) {\n    if (data[key]) lines.push(label + ': ' + String(data[key]).slice(0, 900));\n  }\n} else {\n  lines.push('Contacto desde la web (sin contexto de diagnóstico)');\n  if (claim.message) lines.push('Mensaje: ' + String(claim.message).slice(0, 900));\n}\n\nreturn {\n  json: {\n    ...claim,\n    ghl_solution: solution,\n    ghl_note: lines.join('\\n').slice(0, 3000),\n  },\n};"
      }
    },
