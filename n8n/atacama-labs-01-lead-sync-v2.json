        "method": "GET",
        "url": "={{ \"https://uwquwjmiofixzugttals.supabase.co/rest/v1/lead_submissions?id=eq.\" + $json.lead_id + \"&select=service,plan,interest,source_page,source_section,source_cta,campaign,diagnostic_data\" }}",
