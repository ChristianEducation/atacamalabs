   "name": "Require ICP Pack ID",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    -1120,
    0
   ],
   "parameters": {
    "jsCode": "const incoming = $input.first()?.json ?? {};\nconst EXPECTED_ICP_PACK_ID = '0ba54785-bff0-4a2d-a397-64e697d34e38';\nif (!incoming.icp_pack_id) {\n  throw new Error('SEGURIDAD: icp_pack_id es obligatorio para el orquestador. Sin valor por defecto, sin resolucion por slug. Abortando antes de leer o escribir nada.');\n}\nif (incoming.icp_pack_id !== EXPECTED_ICP_PACK_ID) {\n  throw new Error(`SEGURIDAD: icp_pack_id recibido (${incoming.icp_pack_id}) no coincide con el esperado (${EXPECTED_ICP_PACK_ID}) para esta copia del orquestador. Abortando.`);\n}\nconst cohortLimit = Math.max(1, Math.min(25, Number(incoming.cohort_limit) || 25));\nreturn [{ json: {\n  icp_pack_id: EXPECTED_ICP_PACK_ID,\n  cohort_limit: cohortLimit,\n  skip_discovery: incoming.skip_discovery === true,\n  run_label: incoming.run_label || ('cohorte-' + new Date().toISOString().slice(0,10)),\n} }];"
   }
  },
