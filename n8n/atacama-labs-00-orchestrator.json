  {
   "id": "4146a633-3285-4e44-aed9-827e6ecb157e",
   "name": "Check Lock Acquired",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    320,
    0
   ],
   "parameters": {
    "jsCode": "const cfg = $('Note Recovered Claims').first().json;\nconst res = $json;\nconst status = Number(res.statusCode ?? 0);\nconst body = res.body ?? res;\nif (status === 409 || (status >= 400 && JSON.stringify(body).includes('runs_one_active_per_pack'))) {\n  throw new Error('LOCK: ya existe una ejecucion en curso (status=running) para este icp_pack_id en la tabla runs. Abortando para evitar ejecuciones superpuestas. Espera a que termine o revisa/corrige manualmente esa fila si quedo atascada.');\n}\nif (status < 200 || status >= 300 || !Array.isArray(body) || !body.length) {\n  throw new Error(`No se pudo crear el run (lock): HTTP ${status} ${JSON.stringify(body).slice(0,300)}`);\n}\nconst run = body[0];\nreturn [{ json: { icp_pack_id: cfg.icp_pack_id, cohort_limit: cfg.cohort_limit, skip_discovery: cfg.skip_discovery, run_id: run.id } }];"
   }
  },
