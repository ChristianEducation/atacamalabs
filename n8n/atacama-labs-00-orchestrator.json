  {
   "id": "f1a2fc6c-d03a-449f-bbd2-570ae38dfbdb",
   "name": "Assert Pack Active",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    -640,
    0
   ],
   "parameters": {
    "jsCode": "const cfg = $('Require ICP Pack ID').first().json;\nconst res = $json;\nconst status = Number(res.statusCode ?? 0);\nconst body = res.body ?? res;\nconst row = Array.isArray(body) ? body[0] : null;\nif (status < 200 || status >= 300 || !row || row.id !== cfg.icp_pack_id) {\n  throw new Error(`SEGURIDAD: ICP pack ${cfg.icp_pack_id} no encontrado o no esta 'active' (HTTP ${status}). Abortando antes de crear el run.`);\n}\nreturn [{ json: cfg }];"
   }
  },
