  {
   "id": "d3686c59-33a2-426e-ad6d-93b511157dc1",
   "name": "Init ICP Config",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    -960,
    -60
   ],
   "parameters": {
    "jsCode": "const incoming = $input.first()?.json ?? {};\nconst icpPackId = incoming.icp_pack_id || null;\nconst icpPackSlug = incoming.icp_pack_slug || null;\nif (!icpPackId && !icpPackSlug) throw new Error('SEGURIDAD: icp_pack_id o icp_pack_slug es obligatorio (sin valor por defecto). Abortando.');\nconst filter = icpPackId ? `id=eq.${icpPackId}` : `slug=eq.${icpPackSlug}`;\nreturn [{json:{ icp_pack_url: `https://uwquwjmiofixzugttals.supabase.co/rest/v1/icp_packs?${filter}&select=id,slug,status,crm&limit=1` }}];"
   }
  },
  {
   "id": "32d0aaec-b540-448d-85ac-737998f67031",
   "name": "Fetch ICP Pack",
   "type": "n8n-nodes-base.httpRequest",
   "typeVersion": 4.2,
   "position": [
    -740,
    -60
   ],
   "parameters": {
    "url": "={{ $json.icp_pack_url }}",
    "authentication": "predefinedCredentialType",
    "nodeCredentialType": "supabaseApi",
    "options": {
     "response": {
      "response": {
       "fullResponse": true,
       "neverError": true,
       "responseFormat": "json"
      }
     },
     "timeout": 15000
    }
   },
   "credentials": {
    "supabaseApi": {
     "id": "XOmXUuyLVSazDIh5",
     "name": "Atacama Labs - Supabase"
    }
   }
  },
  {
   "id": "06d41d5e-1bff-4657-964f-b49d0896dd9d",
   "name": "Parse ICP Pack",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    -520,
    -60
   ],
   "parameters": {
    "jsCode": "const res = $input.first().json ?? {};\nconst status = Number(res.statusCode ?? 0);\nconst body = res.body ?? res;\nconst row = Array.isArray(body) ? body[0] : body;\nif (status < 200 || status >= 300 || !row || !row.id) throw new Error(`ICP Pack no encontrado (HTTP ${status || 'unknown'}).`);\nif (row.status !== 'active') throw new Error(`ICP Pack '${row.slug}' esta en estado '${row.status}', no 'active'.`);\nif (!row.crm || !row.crm.pipeline_id || !row.crm.new_stage_id || !row.crm.fields) throw new Error(`ICP Pack '${row.slug}' no tiene crm.pipeline_id/new_stage_id/fields configurados.`);\nreturn [{ json: { icp_pack_id: row.id, icp_pack_slug: row.slug, crm: row.crm } }];"
   }
  },
  {
   "id": "3bf9715a-9f5c-4429-92e8-ae20a2c019e8",
   "name": "Assert Expected Pack",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    -300,
    -60
   ],
   "parameters": {
    "jsCode": "const EXPECTED_ICP_PACK_ID = 'f412a742-7c7f-4cc0-9e2a-20c39d6fcd46';\nconst EXPECTED_ICP_PACK_SLUG = 'atacama-labs-test';\nconst row = $json;\nif (row.icp_pack_id !== EXPECTED_ICP_PACK_ID || row.icp_pack_slug !== EXPECTED_ICP_PACK_SLUG) {\n  throw new Error(`SEGURIDAD: ICP pack resuelto (${row.icp_pack_slug} / ${row.icp_pack_id}) NO coincide con el esperado (${EXPECTED_ICP_PACK_SLUG} / ${EXPECTED_ICP_PACK_ID}). Abortando antes de leer o escribir nada.`);\n}\nreturn [{ json: { ...row, EXPECTED_ICP_PACK_ID, EXPECTED_ICP_PACK_SLUG } }];"
   }
  },
  {
   "id": "0014d621-b816-4e17-8cfb-e7463bbc032e",
   "name": "Fetch Approved Prospects",
   "type": "n8n-nodes-base.httpRequest",
   "typeVersion": 4.2,
   "position": [
    -80,
    -60
   ],
   "parameters": {
    "url": "={{ 'https://uwquwjmiofixzugttals.supabase.co/rest/v1/prospects?icp_pack_id=eq.' + 'f412a742-7c7f-4cc0-9e2a-20c39d6fcd46' + '&status=eq.ready_to_contact&crm_candidate=eq.true&ghl_opportunity_id=is.null&select=id,icp_pack_id&limit=25' }}",
    "authentication": "predefinedCredentialType",
    "nodeCredentialType": "supabaseApi",
    "options": {
     "response": {
      "response": {
       "fullResponse": true,
       "neverError": true,
       "responseFormat": "json"
      }
     },
     "timeout": 20000
    }
   },
   "credentials": {
    "supabaseApi": {
     "id": "XOmXUuyLVSazDIh5",
     "name": "Atacama Labs - Supabase"
    }
   }
  },
  {
   "id": "39e78a68-397f-4fbe-bf7a-6920eceba72a",
   "name": "Build Approved List",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    140,
    -60
   ],
   "parameters": {
    "jsCode": "const res = $input.first().json ?? {};\nconst status = Number(res.statusCode ?? 0);\nconst body = res.body ?? res;\nif (status < 200 || status >= 300) throw new Error(`Fetch approved prospects failed: HTTP ${status || 'unknown'}`);\nconst rows = Array.isArray(body) ? body : [];\nreturn rows.map(r => ({ json: r }));"
   }
  },
  {
   "id": "2335169a-095e-491b-a00a-5d0662777575",
   "name": "Assert Expected Pack (before enqueue)",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    360,
    -60
   ],
   "parameters": {
    "mode": "runOnceForEachItem",
    "jsCode": "const EXPECTED_ICP_PACK_ID = 'f412a742-7c7f-4cc0-9e2a-20c39d6fcd46';\nconst item = $json;\nif (item.icp_pack_id !== EXPECTED_ICP_PACK_ID) throw new Error(`SEGURIDAD: prospect ${item.id} tiene icp_pack_id (${item.icp_pack_id}) distinto del esperado (${EXPECTED_ICP_PACK_ID}). Abortando antes de encolar.`);\nreturn { json: item };"
   }
  },
