  {
   "id": "3fc1c0ef-a778-4024-a68f-e7824dd0f17f",
   "name": "Build Approved List",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    140,
    -60
   ],
   "parameters": {
    "jsCode": "const res = $input.first().json ?? {};\nconst status = Number(res.statusCode ?? 0);\nconst body = res.body ?? res;\nif (status < 200 || status >= 300) throw new Error(`Fetch approved prospects failed: HTTP ${status || 'unknown'}`);\nconst rows = Array.isArray(body) ? body : [];\nreturn rows.map(r => ({ json: r }));"
   }
  },
  {
   "id": "16fbf173-21c2-4cf0-afb6-e0d2ecdb36c1",
   "name": "Assert Expected Pack (before enqueue)",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    360,
    -60
   ],
   "parameters": {
    "mode": "runOnceForEachItem",
    "jsCode": "const EXPECTED_ICP_PACK_ID = 'f412a742-7c7f-4cc0-9e2a-20c39d6fcd46';\nconst item = $json;\nif (item.icp_pack_id !== EXPECTED_ICP_PACK_ID) throw new Error(`SEGURIDAD: prospect ${item.id} tiene icp_pack_id (${item.icp_pack_id}) distinto del esperado (${EXPECTED_ICP_PACK_ID}). Abortando antes de encolar.`);\nreturn { json: item };"
   }
  },
