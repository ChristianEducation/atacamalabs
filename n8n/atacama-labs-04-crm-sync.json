   "name": "Fetch Approved Prospects",
   "type": "n8n-nodes-base.httpRequest",
   "typeVersion": 4.2,
   "position": [
    -80,
    -60
   ],
   "parameters": {
    "url": "={{ 'https://uwquwjmiofixzugttals.supabase.co/rest/v1/prospects?icp_pack_id=eq.' + 'f412a742-7c7f-4cc0-9e2a-20c39d6fcd46' + '&status=eq.ready_to_contact&crm_candidate=eq.true&ghl_opportunity_id=is.null&select=id,icp_pack_id&limit=25' }}",
    "authentication": "predefinedCredentialType",
    "nodeCredentialType": "supabaseApi",
    "options": {
     "response": {
      "response": {
       "fullResponse": true,
       "neverError": true,
       "responseFormat": "json"
      }
     },
