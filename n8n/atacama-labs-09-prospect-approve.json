      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2160,
        -100
      ],
      "executeOnce": true,
      "parameters": {
        "url": "={{ 'https://uwquwjmiofixzugttals.supabase.co/rest/v1/outreach?prospect_id=in.(' + $('Build Approved List').first().json.approved_prospect_ids.join(',') + ')&select=prospect_id,status,channel,subject,sent_at' }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "options": {
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true,
              "responseFormat": "json"
            }
          },
          "timeout": 20000
        }
      },
      "credentials": {
        "supabaseApi": {
          "id": "XOmXUuyLVSazDIh5",
          "name": "Atacama Labs - Supabase"
        }
      }
    },
    {
      "id": "21c7e018-dc99-414f-bfa3-5fdeece0eeda",
      "name": "Response (approved)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2400,
        -100
      ],
      "executeOnce": true,
      "parameters": {
        "jsCode": "const a = $('Build Approved List').first().json;\nconst pr = $('Fetch Prospect Status').first().json;\nconst dr = $input.first().json;\nconst prospects = Array.isArray(pr.body) ? pr.body : [];\nconst drafts = Array.isArray(dr.body) ? dr.body : [];\nconst result = a.approved_prospect_ids.map((id) => {\n  const p = prospects.find((x) => x.id === id) ?? {};\n  const d = drafts.filter((x) => x.prospect_id === id);\n  return { prospect_id: id, status: p.status ?? null, in_crm: Boolean(p.ghl_opportunity_id), draft: d.find((x) => x.status === 'draft')?.subject ?? null, sent: d.some((x) => x.sent_at) };\n});\nreturn [{ json: { ok: true, approved: a.approved, approved_by: a.approved_by, skipped_not_eligible: a.skipped_not_eligible, result, note: 'Solo borradores: no se envia ningun mensaje.' } }];"
      }
    },
    {
      "id": "058b98b4-a22f-4054-8a16-298d8a8a4e07",
      "name": "Response (none eligible)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1200,
        100
      ],
      "parameters": {
        "jsCode": "const a = $input.first().json;\nreturn [{ json: { ok: true, approved: 0, skipped_not_eligible: a.skipped_not_eligible, note: 'Ningun prospecto elegible (debe ser hot, crm_candidate y status=new).' } }];"
      }
    }
  ],
